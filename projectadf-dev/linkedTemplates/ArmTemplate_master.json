{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "projectadf-dev"
		},
		"ADLSsink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://projectdatalakedev.dfs.core.windows.net/"
		},
		"ADLSsink_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "0f374247-afae-41ae-9934-268e5a3e8046"
		},
		"ADLSsink_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "3f6a7dd9-a018-44e2-a085-7be07ee3e43a"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://projectdatalakesource.dfs.core.windows.net/"
		},
		"AzureDataLakeStorage1_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "0f374247-afae-41ae-9934-268e5a3e8046"
		},
		"AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "3f6a7dd9-a018-44e2-a085-7be07ee3e43a"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://projectkeyvault-dev.vault.azure.net/"
		},
		"AzureSqlDatabase_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project-source.database.windows.net"
		},
		"AzureSqlDatabase_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "projectsource"
		},
		"AzureSqlDatabase_source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "project-source"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "projectadf-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"ADLSsink_properties_typeProperties_url": {
						"value": "[parameters('ADLSsink_properties_typeProperties_url')]"
					},
					"ADLSsink_properties_typeProperties_tenant": {
						"value": "[parameters('ADLSsink_properties_typeProperties_tenant')]"
					},
					"ADLSsink_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('ADLSsink_properties_typeProperties_servicePrincipalId')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_tenant": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_tenant')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_servicePrincipalId')]"
					},
					"AzureSqlDatabase_source_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_source_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_source_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_source_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_source_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_source_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}